{
  "name": "@overengineered/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsup src/server.ts --format esm --out-dir dist --no-splitting",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/etag": "latest",
    "@fastify/rate-limit": "latest",
    "@overengineered/build-metadata": "workspace:*",
    "@overengineered/content": "workspace:*",
    "@overengineered/contracts": "workspace:*",
    "@overengineered/domain": "workspace:*",
    "@overengineered/event-bus": "workspace:*",
    "@overengineered/feature-flags": "workspace:*",
    "@overengineered/observability": "workspace:*",
    "@overengineered/one-line-copy": "workspace:*",
    "@overengineered/policy-engine": "workspace:*",
    "@overengineered/runtime-config": "workspace:*",
    "fastify": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsup": "catalog:",
    "tsx": "latest",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
