{
  "title": "Doctrine Delivery and Purpose Dilution",
  "uid": "doctrine-purpose",
  "schemaVersion": 40,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "targets": [{ "expr": "rate(doctrine_requests_total[5m])" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Fallback rate",
      "targets": [{ "expr": "rate(fallback_activations_total[5m])" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Complexity-to-page ratio",
      "targets": [{ "expr": "architecture_units / user_visible_pages" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Policy denials",
      "targets": [{ "expr": "rate(policy_evaluations_total{decision=\"deny\"}[5m])" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Principle rendering latency",
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(principle_render_duration_bucket[5m]))" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Original intent discoverability",
      "targets": [{ "expr": "purpose_record_discoverable" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 }
    }
  ]
}
