{
  "name": "overengineered",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev --filter=@overengineered/web --filter=@overengineered/gateway --filter=@overengineered/api --filter=@overengineered/worker",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "vitest run packages",
    "test:integration": "vitest run tests/integration",
    "test:contracts": "vitest run tests/contracts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "docs:dev": "pnpm --filter @overengineered/docs dev",
    "docs:build": "pnpm --filter @overengineered/docs build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "graph": "nx graph",
    "affected": "nx affected -t lint,typecheck,test",
    "doctrine": "node --import tsx scripts/doctrine.ts",
    "purpose:check": "node --import tsx scripts/purpose-check.ts",
    "health:deep": "node --import tsx scripts/health-deep.ts",
    "ci:local": "pnpm purpose:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:validate": "node --import tsx packages/design-tokens/src/validate.ts",
    "docs:governance": "node --import tsx scripts/docs-governance.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "latest",
    "@changesets/cli": "latest",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@cyclonedx/cyclonedx-npm": "latest",
    "@eslint/js": "latest",
    "@lhci/cli": "latest",
    "@nx/js": "latest",
    "@playwright/test": "latest",
    "@stryker-mutator/core": "latest",
    "@stryker-mutator/vitest-runner": "latest",
    "@storybook/addon-a11y": "latest",
    "@storybook/nextjs-vite": "latest",
    "@storybook/react": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "cspell": "latest",
    "dependency-cruiser": "latest",
    "eslint": "latest",
    "husky": "latest",
    "knip": "latest",
    "license-checker-rseidelsohn": "latest",
    "lint-staged": "latest",
    "madge": "latest",
    "markdownlint-cli2": "latest",
    "msw": "latest",
    "nx": "latest",
    "prettier": "latest",
    "storybook": "latest",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "^7.0.2",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml,css}": "prettier --write"
  }
}
